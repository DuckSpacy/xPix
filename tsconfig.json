{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",

    "outDir": "./dist",
    "rootDir": "./src",

    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,

    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
