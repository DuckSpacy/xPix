{
  "name": "xpix",
  "version": "0.0.1",
  "type": "module",
  "description": "Stable UI pixel system for mobile WebApps (fixes Android scaling, 428px design).",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky install"
  },
  "keywords": [
    "pixel",
    "pixel-system",
    "pixel-normalization",
    "android-scaling",
    "android-display-size",
    "dpi",
    "dpi-normalization",
    "viewport",
    "viewport-scaling",
    "webapp",
    "mobile-webapp",
    "twa",
    "telegram-webapp",
    "ui-stability",
    "cross-device-ui",
    "428px-design",
    "css-variables",
    "svelte",
    "sveltekit",
    "mobile-ui",
    "responsive",
    "adaptive"
  ],
  "author": "duck.spacy",
  "license": "MIT",

  "repository": {
    "type": "git",
    "url": "https://github.com/DuckSpacy/xPix.git"
  },
  "homepage": "https://github.com/DuckSpacy/xPix",
  "bugs": {
    "url": "https://github.com/DuckSpacy/xPix/issues"
  },

  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "husky": "^8.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
